# ===================================================================
# Field Service Dispatch & Replanning Agent (DispatchIQ)
# Root Environment Configuration Template
# ===================================================================

# -------------------------------------------------------------------
# Backend Environment Variables (server/.env)
# -------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# AI Provider: 'gemini' (Free Google AI Studio) or 'mock' (Zero-token local solver)
AI_PROVIDER=gemini

# Google Gemini Free API Key (Get free key at: https://aistudio.google.com/)
# Starts with 'AIzaSy...'
GEMINI_API_KEY=your_free_google_ai_studio_api_key_here

# -------------------------------------------------------------------
# Frontend Environment Variables (client/.env or Vercel Settings)
# -------------------------------------------------------------------
# Local dev: /api (proxied via Vite to http://localhost:5000)
# Production: https://your-backend-service.onrender.com/api
VITE_API_URL=/api
