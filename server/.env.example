# DispatchIQ Server Environment Variables

# Port (Render automatically sets this in production)
PORT=5000
NODE_ENV=production

# AI Provider: 'gemini' (Free Google AI Studio) or 'mock' (Zero-token local solver)
AI_PROVIDER=gemini

# Google Gemini Free API Key
# 1. Go to https://aistudio.google.com/
# 2. Click "Get API key" -> "Create API key" (100% Free, no credit card required)
# 3. Paste the key below:
GEMINI_API_KEY=your_free_google_gemini_api_key_here
